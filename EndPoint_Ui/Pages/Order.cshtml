@page
@using Domain.Enums
@model EndPoint_Ui.Pages.OrderModel

@{
    string? title = "سفارش طراحی سایت اختصاصی";
}
<partial name="/Pages/Shared/Partial/_HeaderPage.cshtml" model="@title" />

@section Script {
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>

    <partial name="_ValidationScriptsPartial.cshtml" />
    <script src="~/js/order.js"></script>
    <script src="~/js/rest.js"></script>
    <script src="~/js/sweetalert.js"></script>
}


<section class="contact-us-section ptb-100">
    <div class="container">
        <div class="row justify-content-around">
            <div class="col-md-12  col-sm-12 col-lg-12">
                <div class="contact-us-form gray-light-bg rounded p-5 text-center">

                    <div class="contact-us-form" novalidate="novalidate">
                      
                        <div class="alert alert-info">
                            در صورتی که در حال حاضر دارای سایت می باشید لطفا دامنه سایت خود را وارد کنید

                        </div>
                        @if (ViewData["Message"] != null)
                        {
                            <div class="alert alert-warning " >
                                <h3>
                                    @ViewData["Message"]
                                </h3>
                            </div>
                        }
                        <div class="row">


                            <div class="col-3">
                                <div class="form-group text-left">
                                    <label >نام و نام خانوادگی</label>

                                    <input type="text"
                                           id="FullName" placeholder="نام نام خانوادگی" class="form-control">
                                </div>
                            </div>


                            <div class="col-3">
                                <div class="form-group">
                                    <label>شماره تماس</label>
                                    <input type="text"
                                           id="PhoneNumber" placeholder="  شماره تماس" class="form-control">
                                </div>
                            </div>




                            <div class="col-3">
                                <label>ایمیل</label>
                                <div class="form-group">
                                    <input type="email" id="Email" placeholder="ایمیل" class="form-control">
                                </div>
                            </div>
                            


                            <div class="col-3">

                                <div class="form-group">
                                    <label>پیوست فایل</label>
                                    <input type="file"
                                           id="File" class="form-control">
                                </div>
                            </div>

                            
                            <div class="col-3">
                                <div class="form-group">
                                    <label>لینک سایت</label>
                                    <input type="text" id="Url" placeholder="لینک سایت" class="form-control">
                                </div>
                            </div>



                            <div class="col-3">
                                <div class="form-group">
                                    <label>عنوان </label>
                                    <input id="Title" type="text" placeholder="مثال:طراحی سایت شرکت دارنو" class="form-control">
                                </div>
                            </div>





                            <div class="col-3">
                                <label>نوع پروژه</label>
                                <div class="form-group">
                                    <select asp-items="Html.GetEnumSelectList<ProjectType>()"
                                            id="ProjectType"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>





                            <div class="col-3">
                                <div class="form-group">
                                    <label> تکنولوژی پیاده سازی</label>
                                    <select asp-items="Html.GetEnumSelectList<PlatformType>()"
                                            id="PlatformType"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>


                            <div class="col-3">
                                <div class="form-group">
                                    <label>قابلیت درگاه پرداخت</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="IsOnlinePaymentGateway"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>


                            

                            <div class="col-3">
                                <div class="form-group">
                                    <label>قابلیت چند زبانه</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="IsMultilingual"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>



                            <div class="col-3">
                                <div class="form-group">
                                    <label>قابلیت ارسال پیامک</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="IsSms"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>


                            
                            <div class="col-3">
                                <div class="form-group">
                                    <label>قابلیت چت آنلاین</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="IsOnlineChat"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>


                             
                            <div class="col-3">
                                <div class="form-group">
                                    <label>قابلیت گزارش گیری</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="IsReport"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>



                             
                            <div class="col-3">
                                <div class="form-group">
                                    <label>
                                        نسخه PWA
                                    </label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="IsPwa"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>



                            
                            <div class="col-3">
                                <div class="form-group">
                                    <label>هاست</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="HaveHost"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>




                                 <div class="col-3">
                                <div class="form-group">
                                    <label>دامنه</label>
                                    <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                            id="HaveDomain"
                                            class="form-control">
                                    </select>
                                </div>
                            </div>













                        </div>




                        <div class="col-12">
                            <div class="form-group">
                                <label>توضیحات</label>
                                <textarea id="Description" class="form-control" style="height:200px"
                                          cols="25" placeholder="توضیحات"></textarea>
                            </div>
                        </div>
                        <div class="col-sm-12 mt-3">
                            <button type="button"
                                    onclick="InsertOrder()" class="btn secondary-solid-btn" id="btnContactUs">
                                ارسال درخواست
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

