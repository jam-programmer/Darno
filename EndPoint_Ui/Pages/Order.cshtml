@page
@using Domain.Enums
@model EndPoint_Ui.Pages.OrderModel
@{
}
@section Script {
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>

    <partial name="_ValidationScriptsPartial.cshtml" />
    <script src="~/js/order.js"></script>
    <script src="~/js/rest.js"></script>
    <script src="~/js/sweetalert.js"></script>
}
<section class="hero  overflow-hidden relative max-lg:pt-150 pt-[240px] pb-[60px] z-40">
    <div class="container">
        <div class="max-w-[948px] mx-auto text-center aos-init aos-animate" data-aos="fade-up" data-aos-offset="200" data-aos-duration="1000" data-aos-once="true">
            <p class="mb-4 font-medium uppercase">منتظریم تا در این مسیر همراه شما باشیم</p>
            <h1 class="max-lg:mb-10 mb-10">سفارش طراحی سایت</h1>
          <p>درخواست خود را ثبت کنید تا در اولین فرصت با شما ارتباط برقرار کنیم</p>
        </div>
    </div>
</section>
<section class="pb-150 relative">
    <div class="absolute left-1/2 -top-[300px] w-full h-[550px] -translate-x-1/2 bg-cover  bg-[url('../images/hero-gradient.png')] bg-no-repeat bg-center opacity-70 md:hidden -z-10"></div>
    <div class="container">
        <div class="relative z-10  mx-auto" >
            <div class="absolute left-1/2 top-150 -translate-x-1/2 -translate-y-1/2 flex max-md:flex-col -z-10 max-md:hidden">
                <div class="max-1xl:w-[335px] max-1xl:h-[335px]  1xl:w-[442px] 1xl:h-[442px]  rounded-full bg-primary-200/20 blur-[145px]"></div>
                <div class="max-1xl:w-[335px] max-1xl:h-[335px]  1xl:w-[442px] 1xl:h-[442px]  rounded-full bg-primary-200/25 -ml-[170px] max-md:ml-0 blur-[145px]"></div>
                <div class="max-1xl:w-[335px] max-1xl:h-[335px]  1xl:w-[442px] 1xl:h-[442px]  rounded-full bg-primary-200/20 -ml-[170px] max-md:ml-0 blur-[145px]"></div>
            </div>

          

            <div dir="rtl" class="rounded-medium p-2.5">
                @if (ViewData["Message"] != null)
                {
                    <div class="alert alert-success alert-show" id="successAlert">
                        <h3>
                            @ViewData["Message"]
                        </h3>
                        <button class="close-btn" id="closeAlert">&times;</button>
                    </div>
                }
                
                <div class="bg-white dark:bg-dark-200 border border-dashed rounded border-gray-100 dark:border-borderColour-dark p-12 max-md:p-5">
                    <div >
                        <div class="grid grid-cols-12 max-md:gap-y-10 md:gap-x-12 md:gap-8">
                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    نام نام خانوادگی
                                    <span class="text-red">*</span>
                                </label>
                                <input type="text" id="FullName" placeholder="نام نام خانوادگی" class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                            </div>
                            
                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    شماره تماس
                                    <span class="text-red">*</span>
                                </label>
                                <input type="tel" id="PhoneNumber" placeholder="  شماره تماس" class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">

                            </div>
                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="email" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    ایمیل
                                </label>
                                <input type="email" id="Email" placeholder="ایمیل" class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                            </div>


                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    عنوان
                                    <span class="text-red">*</span>
                                </label>
                                <input id="Title" type="text" placeholder="مثال:طراحی سایت شرکت دارنو" class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                              

                            </div>


                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                   نوع پروژه
                                    <span class="text-red">*</span>
                                </label>
                                <select asp-items="Html.GetEnumSelectList<ProjectType>()"
                                        id="ProjectType"
                                   class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                 
                          
                               </select>

                               </div>

                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    نوع تکنولوژی پیاده سازی
                                    <span class="text-red">*</span>
                                </label>
                                <select asp-items="Html.GetEnumSelectList<PlatformType>()"
                                        id="PlatformType"
                                    class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>

                            </div>


                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    درگاه پرداخت
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                        id="IsOnlinePaymentGateway"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                            
                                    </select>
                            </div>


                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    قابلیت چند زبانه
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                        id="IsMultilingual"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>

                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    قابلیت ارسال پیامک
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                        id="IsSms"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>

                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    قابلیت چت آنلاین
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                       id="IsOnlineChat"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>

                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                   قابلیت گزارش گیری
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                        id="IsReport"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>

                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                   نسخه PWA
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                        id="IsPwa"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>



                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                 هاست
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                       id="HaveHost"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>

                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    دامنه
                                </label>
                                <select asp-items="Html.GetEnumSelectList<NeedType>()"
                                      id="HaveDomain"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">
                                </select>
                            </div>



                            <div class="max-md:col-span-full md:col-span-4">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    فایل پیوستی
                                </label>
                                <input type="file"
                                       id="File"
                                       style="background-color: #6077eb52;"
                                        class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all"/>
                                
                            </div>
                            <div class="col-span-full">
                                <label for="username" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                لینک سایت
                                   
                                </label>
                                <input type="text" id="Url" placeholder="لینک سایت" class="block w-full text-sm rounded-[48px] border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light dark:placeholder:text-paragraph-light outline-blue bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all">


                                <span class="text-red" style="margin-top:10px;">در صورتی که در حال حاضر دارای سایت می باشید لطفا دامنه سایت خود را وارد کنید</span>
                            </div>

                            <div class="col-span-full">
                                <label for="message" class="block text-sm font-medium text-paragraph dark:text-white mb-2">
                                    توضیحات
                                    <span class="text-red">*</span>
                                </label>
                                <textarea id="Description" rows="10" class="block w-full text-sm rounded border border-borderColour dark:border-borderColour-dark py-2.5 px-5 text-paragraph-light placeholder:text-paragraph-light outline-blue resize-none bg-white dark:bg-dark-200 focus:border-primary dark:focus:border-primary duration-300 transition-all"></textarea>

                            </div>
                            <div class="mx-auto col-span-full text-center">
                                <a onclick="InsertOrder()" style="cursor:pointer;" class="btn">ارسال درخواست</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>