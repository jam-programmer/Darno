@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<section class="splide" aria-label="اسلایدر تصاویر">
    <div class="splide__track">
        <ul class="splide__list">
            <li class="splide__slide">
                <img src="~/images/100.png" alt="تصویر 1" />
            </li>
            <li class="splide__slide">
                <img src="~/images/200.jpg" alt="تصویر 2" />
            </li>
            <!-- می‌توانید اسلایدهای بیشتری اضافه کنید -->
        </ul>
    </div>
</section>
       
@await Component.InvokeAsync("ServiceComponent")
@await Component.InvokeAsync("MembrsComponenets")
@await Component.InvokeAsync("QuestionComponent")

@section Style {
    <link href="~/splidejs/splide.min.css" rel="stylesheet"/>
    <link href="~/splidejs/splidecustom.css" rel="stylesheet"/>
}
@section Script {
    <script src="~/splidejs/splide.min.js"></script>
    <script src="~/splidejs/splidecustom.js"></script>
   
 }