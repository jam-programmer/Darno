@page
@model EndPoint_Ui.Pages.SignInModel
@{
}


<section class="hero-section hero-bg-2 ptb-100 full-screen">
    <div class="container">
        <div class="row align-items-center justify-content-between pt-5 pt-sm-5 pt-md-5 pt-lg-0">
            <div class="col-md-7 col-lg-6">
                <div class="hero-content-left text-white">
                    <h3 class="text-white">  ورود به حساب کاربری</h3>
                   
                </div>
            </div>
            <div class="col-md-5 col-lg-5">
                <div class="card login-signup-card shadow-lg mb-0">
                    <div class="card-body px-md-5 py-5">
                        <div class="mb-5">
                            <h5 class="h3"> ورود</h5>
                            <p class="text-muted mb-0">برای ادامه به حساب کاربری خود وارد شوید</p>
                        </div>
                        @if (ViewData["Alert"] != null)
                        {
                            <div class="alert alert-warning">@ViewData["Alert"]</div>
                        }
                        <!--login form-->
                        <form asp-page="SignIn" class="login-signup-form">
                            <div class="form-group">
                                <label class="pb-1">   نام کاربری</label>
                                <div class="input-group input-group-merge">
                                    <div class="input-icon">
                                        <span class="ti-user color-primary"></span>
                                    </div>
                                    <input asp-for="SignIn.UserName" type="text" class="form-control" >
                                    <span class="text-danger" asp-validation-for="SignIn.UserName"></span>
                                </div>
                            </div>
                            <!-- Password -->
                            <div class="form-group">
                                <div class="row">
                                    <div class="col">
                                        <label class="pb-1">کلمه عبور</label>
                                    </div>
                                  
                                </div>
                                <div class="input-group input-group-merge">
                                    <div class="input-icon">
                                        <span class="ti-lock color-primary"></span>
                                    </div>
                                    <input class="form-control" type="password" asp-for="SignIn.Password"
                                           placeholder="گذرواژه را وارد کنید">
                                    <span class="text-danger" 
                                          asp-validation-for="SignIn.Password"></span>
                                </div>
                            </div>

                            <label >
                                <input asp-for="SignIn.RememberMe" id="remember-me" type="checkbox" class="form-check-input"/>

                                <span class=" text-sm text-dark mx-2">
                                    به یاد داشته باش
                                </span>
                            </label>
                            <!-- Submit -->
                            <button class="btn btn-block secondary-solid-btn border-radius mt-4 mb-3">
                                ورود
                            </button>

                        </form>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</section>

@section Script {


    <partial name="_ValidationScriptsPartial.cshtml" />
}


