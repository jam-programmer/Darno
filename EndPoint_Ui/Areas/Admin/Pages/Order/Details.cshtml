@page

@model EndPoint_Ui.Areas.Admin.Pages.Order.Details;
@using Application.Common.Extension

<div class="card">
    <table class="table table-hover">
        <tbody>
            <tr>
                <th class="table-light">نام مشتری</th>
                <td>@Model.Order.FullName</td>
            </tr>
            <tr>
                <th class ="table-light">عنوان پروژه</th>
                <td>@Model.Order.Title</td>
            </tr>
            <tr>
                <th class="table-light">نوع پروژه</th>
                <td>@Model.Order.ProjectType.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">شماره تلفن</th>
                <td>@Model.Order.PhoneNumber</td>
            </tr>
            <tr>
                <th class="table-light">نوع پلتفرم</th>
                <td>@Model.Order.PlatformType.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">توضیحات</th>
                <td>@Model.Order.Description</td>
            </tr>
            <tr>
                <th class="table-light">ایمیل</th>
                <td>@Model.Order.Email</td>
            </tr>
            <tr>
                <th class="table-light">چندزبانه</th>
                <td>@Model.Order.IsMultilingual.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">ارسال پیامک</th>
                <td>@Model.Order.IsSms.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">چت آنلاین</th>
                <td>@Model.Order.IsOnlinePaymentGateway.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">بلاگ</th>
                <td>@Model.Order.IsBlog.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">گزارش‌دهی</th>
                <td>@Model.Order.IsReport.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">قیمت (تومان/ریال)</th>
                <td>@Model.Order.Price</td>
            </tr>
            <tr>
                <th class="table-light">اپلیکیشن PWA</th>
                <td>@Model.Order.IsPwa.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">میزبان (هاست) دارد</th>
                <td>@Model.Order.HaveHost.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">دامنه دارد</th>
                <td>@Model.Order.HaveDomain.GetEnumName()</td>
            </tr>
            <tr>
                <th class="table-light">آدرس سایت</th>
                <td>@Model.Order.Url</td>
            </tr>
            <tr>
                <th class="table-light">فایل ضمیمه</th>
                <td>@Model.Order.File</td>
            </tr>
        </tbody>
    </table>
</div>